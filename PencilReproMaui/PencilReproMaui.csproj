<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Reproduction sample: Apple Pencil stroke disables finger input in a view-only
    PTDocumentController. iOS only. Stack: net10.0-ios + NuGet PDFTron.iOS / PDFTron.iOS.Tools 12.1.0.
    Structure follows the official sample https://github.com/ApryseSDK/maui-sample
    (ViewHandler hosting a native Apryse view controller).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>PencilReproMaui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>PencilRepro MAUI</ApplicationTitle>
    <ApplicationId>com.example.apryse.pencilrepro.maui</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion>16.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">ios-arm64</RuntimeIdentifier>
  </PropertyGroup>

  <!--
    Signing: copy Signing.props.example -> Signing.props (git-ignored) and set your Team ID /
    bundle ID. Without it the project still builds for the simulator.
  -->
  <Import Project="Signing.props" Condition="Exists('Signing.props')" />

  <!--
    Bluetooth: whether the app's Info.plist contains NSBluetoothAlwaysUsageDescription.
    The Apryse SDK detects a paired Apple Pencil with CoreBluetooth, which iOS only allows when the
    key is present.  true (default) = key present, false = key absent:
      dotnet build -f net10.0-ios -p:PencilReproBluetoothUsageKey=false
    Delete the app from the iPad before testing another value: this also resets its Bluetooth
    permission to "not determined".
  -->
  <PropertyGroup>
    <PencilReproBluetoothUsageKey Condition="'$(PencilReproBluetoothUsageKey)' == ''">true</PencilReproBluetoothUsageKey>
  </PropertyGroup>
  <ItemGroup Condition="'$(PencilReproBluetoothUsageKey)' == 'true'">
    <PartialAppManifest Include="Platforms\iOS\Bluetooth.plist" />
  </ItemGroup>

  <ItemGroup>
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <!-- Same SDK version as the reported environment (pinned, no floating range). -->
    <PackageReference Include="PDFTron.iOS" Version="[12.1.0]" />
    <PackageReference Include="PDFTron.iOS.Tools" Version="[12.1.0]" />
  </ItemGroup>

</Project>
